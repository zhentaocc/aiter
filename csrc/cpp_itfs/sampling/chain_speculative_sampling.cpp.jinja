#include "sampling.cuh"


#define FUNCTION_DEFINE                                           \
    void {{func_name}}(void* accept_length_ptr,                   \
                      void* bonus_token_ids_ptr,                  \
                      void* candidates_ptr,                       \
                      void* target_probs_ptr,                     \
                      void* uniform_samples_ptr,                  \
                      void* uniform_samples_final_ptr,            \
                      int batch_size,                             \
                      int draft_len,                              \
                      int vocab_size,                             \
                      float threshold_single,                     \
                      float threshold_acc,                        \
                      void* stream)

extern "C" {
FUNCTION_DEFINE;
}

FUNCTION_DEFINE
{
    const uint32_t smem_size = sizeof(aiter::sampling::SamplingTempStorage<aiter::sampling::BLOCK_THREADS, aiter::sampling::SCAN_ALGO, aiter::sampling::REDUCE_ALGO>);
    dim3 nblks(batch_size);
    dim3 nthrs(aiter::sampling::BLOCK_THREADS);
    auto kernel = aiter::sampling::ChainSpeculativeSamplingKernel<aiter::sampling::BLOCK_THREADS, aiter::sampling::SCAN_ALGO, aiter::sampling::REDUCE_ALGO,
                                                {{vec_size}}, {{"true" if deterministic else "false"}}, float>;
    hipFuncSetAttribute(reinterpret_cast<const void*>(kernel), hipFuncAttributeMaxDynamicSharedMemorySize, smem_size);
    kernel<<<nblks, nthrs, smem_size, reinterpret_cast<hipStream_t>(stream)>>>(
        reinterpret_cast<int32_t*>(accept_length_ptr),
        reinterpret_cast<int32_t*>(bonus_token_ids_ptr),
        reinterpret_cast<int64_t*>(candidates_ptr),
        reinterpret_cast<float*>(target_probs_ptr),
        reinterpret_cast<float*>(uniform_samples_ptr),
        reinterpret_cast<float*>(uniform_samples_final_ptr),
        batch_size,
        draft_len,
        vocab_size,
        threshold_single,
        threshold_acc);
}
